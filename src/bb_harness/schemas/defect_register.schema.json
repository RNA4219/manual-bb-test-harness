{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RNA4219/manual-bb-test-harness/schemas/defect_register.schema.json",
  "title": "DefectRegister",
  "type": "object",
  "required": [
    "feature_id",
    "build_id",
    "defects"
  ],
  "properties": {
    "feature_id": {
      "type": "string",
      "minLength": 1
    },
    "build_id": {
      "type": "string",
      "minLength": 1
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "defect_id",
          "title",
          "severity",
          "status",
          "updated_at",
          "source_refs"
        ],
        "properties": {
          "defect_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "blocker",
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "status": {
            "enum": [
              "open",
              "in_progress",
              "fixed",
              "pending_confirmation",
              "reopened",
              "resolved"
            ]
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "shared_defs.schema.json#/$defs/SourceRef"
            }
          },
          "confirmation_run_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "resolved"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "confirmation_run_ids"
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
