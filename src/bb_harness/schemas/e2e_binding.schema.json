{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RNA4219/manual-bb-test-harness/schemas/e2e_binding.schema.json",
  "title": "Reviewed E2E Binding",
  "$defs": {
    "locatorText": {
      "$comment": "Rust char::is_whitespace() + U+001C..U+001F",
      "type": "string",
      "pattern": "[^\\u0009-\\u000D\\u001C-\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]"
    },
    "locator": {
      "type": "object",
      "oneOf": [
        {
          "required": ["testId"],
          "properties": {
            "testId": { "$ref": "#/$defs/locatorText" }
          },
          "additionalProperties": false
        },
        {
          "required": ["role", "name"],
          "properties": {
            "role": {
              "enum": ["button", "link", "textbox", "checkbox", "combobox", "option", "menuitem", "tab"]
            },
            "name": { "$ref": "#/$defs/locatorText" }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "type": "object",
  "required": [
    "schemaVersion",
    "featureId",
    "specRevision",
    "baseUrl",
    "featureSha256",
    "caseSetSha256",
    "seed",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": "manual-bb/e2e-binding/v1"
    },
    "featureId": {
      "type": "string",
      "minLength": 1
    },
    "specRevision": {
      "type": "string",
      "minLength": 1
    },
    "baseUrl": {
      "type": "string",
      "format": "uri"
    },
    "featureSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "caseSetSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "caseId",
          "revision",
          "contentHash",
          "oracleRevision",
          "reviewedBy",
          "reviewRef",
          "actions",
          "checks"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "contentHash": {
            "type": "string",
            "minLength": 1
          },
          "oracleRevision": {
            "type": "string",
            "minLength": 1
          },
          "reviewedBy": {
            "type": "string",
            "minLength": 1
          },
          "reviewRef": {
            "type": "string",
            "minLength": 1
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "kind"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "navigate",
                    "goto",
                    "click",
                    "fill",
                    "check",
                    "select",
                    "press"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": { "$ref": "#/$defs/locator" },
                "inputProfileId": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
                },
                "key": {
                  "type": "string",
                  "enum": [
                    "Enter",
                    "Escape",
                    "Space",
                    "Tab"
                  ]
                },
                "mutates": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "text",
                "kind"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "url",
                    "visible",
                    "hidden",
                    "textEquals",
                    "amountEquals",
                    "countEquals",
                    "countDelta"
                  ]
                },
                "value": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    }
                  ]
                },
                "locator": { "$ref": "#/$defs/locator" },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "itemLocator": { "$ref": "#/$defs/locator" },
                "afterActionId": {
                  "type": "string",
                  "minLength": 1
                },
                "acceptanceRef": {
                  "type": "string",
                  "minLength": 1
                },
                "currency": {
                  "enum": [
                    "JPY",
                    "USD"
                  ]
                },
                "format": {
                  "enum": [
                    "jpy-yen-suffix",
                    "usd-dollar-prefix"
                  ]
                },
                "minorUnits": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "url"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "value"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "visible"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "locator"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "hidden"
                      }
                    }
                  },
                  "then": {
                    "required": ["locator", "acceptanceRef"],
                    "propertyNames": {
                      "enum": ["text", "kind", "locator", "acceptanceRef", "afterActionId"]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "textEquals"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "locator",
                      "value"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "amountEquals"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "locator",
                      "currency",
                      "format",
                      "minorUnits",
                      "acceptanceRef"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "countEquals"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "locator",
                      "itemLocator",
                      "value",
                      "acceptanceRef"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "countDelta"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "locator",
                      "itemLocator",
                      "value",
                      "acceptanceRef",
                      "afterActionId"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "enum": [
                          "url",
                          "textEquals"
                        ]
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "enum": [
                          "countEquals",
                          "countDelta"
                        ]
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "countEquals"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "value": {
                        "minimum": 0
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "amountEquals"
                      }
                    }
                  },
                  "then": {
                    "oneOf": [
                      {
                        "properties": {
                          "currency": {
                            "const": "JPY"
                          },
                          "format": {
                            "const": "jpy-yen-suffix"
                          }
                        }
                      },
                      {
                        "properties": {
                          "currency": {
                            "const": "USD"
                          },
                          "format": {
                            "const": "usd-dollar-prefix"
                          }
                        }
                      }
                    ]
                  }
                }
              ],
              "dependentRequired": {
                "afterActionId": [
                  "acceptanceRef"
                ]
              }
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
