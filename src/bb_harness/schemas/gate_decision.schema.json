{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RNA4219/manual-bb-test-harness/schemas/gate_decision.schema.json",
  "title": "GateDecision",
  "type": "object",
  "required": [
    "feature_id",
    "build_id",
    "status",
    "profile",
    "reasons",
    "evidence_summary"
  ],
  "properties": {
    "feature_id": {
      "type": "string",
      "minLength": 1
    },
    "build_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "go",
        "conditional_go",
        "no_go"
      ]
    },
    "profile": {
      "enum": [
        "strict",
        "standard",
        "lean"
      ]
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidence_summary": {
      "type": "object",
      "required": [
        "manual_by_priority",
        "mandatory_observation_rate"
      ],
      "properties": {
        "manual_by_priority": {
          "type": "object"
        },
        "mandatory_observation_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "coverage_population": {
          "type": "object",
          "required": ["defined", "mandatory", "observed", "case_traced"],
          "properties": {
            "defined": {"type": "integer", "minimum": 1},
            "mandatory": {"type": "integer", "minimum": 0},
            "observed": {"type": "integer", "minimum": 0},
            "case_traced": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "manual_execution_results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "case_id",
              "result",
              "run_id"
            ],
            "properties": {
              "case_id": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "enum": [
                  "pass",
                  "fail",
                  "skip",
                  "blocked",
                  "unknown",
                  "untested"
                ]
              },
              "run_id": {
                "type": "string"
              },
              "configuration_id": {
                "type": "string",
                "minLength": 1
              },
              "env": {
                "type": "string"
              },
              "device": {
                "type": "string"
              },
              "network_profile": {
                "type": "string"
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": false
          }
        },
        "open_defects": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "automation_test_suites": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "suite_id",
              "status",
              "total",
              "passed",
              "failed",
              "errors",
              "skipped",
              "source_refs"
            ],
            "properties": {
              "suite_id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "error",
                  "cancelled",
                  "not_run"
                ]
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "passed": {
                "type": "integer",
                "minimum": 0
              },
              "failed": {
                "type": "integer",
                "minimum": 0
              },
              "errors": {
                "type": "integer",
                "minimum": 0
              },
              "skipped": {
                "type": "integer",
                "minimum": 0
              },
              "source_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "shared_defs.schema.json#/$defs/SourceRef"
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "blocking_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "risk_ids",
          "reason",
          "owner",
          "approver",
          "approved_at",
          "approval_ref",
          "expires_at",
          "containment",
          "rollback"
        ]
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unmet_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_follow_up": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retired_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "replacement_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Retired manual case ID."
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ],
            "description": "Retired case priority."
          },
          "replacement_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "Replacement coverage references."
          },
          "placement_change_ref": {
            "type": "string",
            "description": "QEG placement change reference."
          },
          "retired_reason": {
            "type": "string",
            "description": "Reason the manual case was retired."
          }
        },
        "additionalProperties": false
      },
      "description": "Manual cases excluded from manual execution counts because they were retired."
    }
  },
  "additionalProperties": false
}
