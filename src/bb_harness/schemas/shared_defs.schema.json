{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RNA4219/manual-bb-test-harness/schemas/shared_defs.schema.json",
  "title": "SharedDefinitions",
  "description": "Shared type definitions used across multiple artifact schemas. Note: $id URLs are identifiers, not resolvable endpoints.",
  "$defs": {
    "SourceRef": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "description": "Reference to a source document that provides basis for artifact content.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Identifier of the source item, e.g., 'AC-1', 'BR-2', 'BUG-123'."
        },
        "kind": {
          "enum": [
            "spec",
            "ac",
            "rule",
            "bug",
            "auto_test",
            "code_review",
            "ops",
            "confluence",
            "jira",
            "mock",
            "memo",
            "interview",
            "metric"
          ],
          "description": "Kind of source: spec (specification), ac (acceptance criteria), rule (business rule), bug (defect), auto_test (automated test), code_review (review comment), ops (operational data), confluence (Confluence page), jira (Jira issue), mock (mockup), memo (planning note), interview (user or stakeholder interview), metric (measurement or KPI)."
        },
        "excerpt": {
          "type": "string",
          "description": "Optional excerpt of the source content for reference."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Optional URL to the source document."
        }
      },
      "additionalProperties": false
    },
    "Assumption": {
      "type": "object",
      "required": [
        "id",
        "text",
        "severity"
      ],
      "description": "Assumption made when information is incomplete. Must be tracked for risk assessment.",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique assumption identifier, e.g., 'ASM-1'."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Description of the assumption made."
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "description": "Severity level: low (minor impact), medium (some impact), high (significant impact), critical (blocking if wrong)."
        },
        "impact_on_coverage": {
          "type": "string",
          "description": "How this assumption affects test coverage or approach."
        },
        "resolution_status": {
          "enum": [
            "open",
            "resolved",
            "accepted"
          ],
          "default": "open",
          "description": "Current status of the assumption."
        }
      },
      "additionalProperties": false
    },
    "Oracle": {
      "type": "object",
      "required": [
        "type",
        "refs"
      ],
      "description": "Oracle definition: how expected results are determined.",
      "properties": {
        "type": {
          "enum": [
            "specified",
            "derived",
            "implicit",
            "human"
          ],
          "description": "Oracle type: specified (in spec/AC), derived (from rules/old system), implicit (standard expectations), human (judgment needed)."
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "References to source for oracle, e.g., ['AC-1', 'BR-2']."
        },
        "notes": {
          "type": "string",
          "description": "Additional notes on oracle derivation or limitations."
        }
      },
      "additionalProperties": false
    },
    "ConfidenceLevel": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "description": "Confidence in correctness: high (well-established), medium (reasonable basis), low (uncertain)."
    },
    "Priority": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ],
      "description": "Risk-based priority: P0 (critical), P1 (high), P2 (medium), P3 (low)."
    },
    "TestView": {
      "type": "string",
      "enum": [
        "black",
        "gray",
        "white"
      ],
      "description": "Testing view: black (external UI), gray (limited diagnostic signals), white (implementation-level)."
    },
    "GateStatus": {
      "type": "string",
      "enum": [
        "go",
        "conditional_go",
        "no_go"
      ],
      "description": "Gate decision: go (release ready), conditional_go (with conditions), no_go (blocked)."
    },
    "TechniqueRef": {
      "type": "object",
      "properties": {
        "key": {
          "enum": [
            "equivalence_partitioning",
            "boundary_value_analysis",
            "domain_testing",
            "combinatorial_testing",
            "random_testing",
            "crud_testing",
            "state_transition_testing",
            "scenario_based_testing",
            "decision_table_testing",
            "metamorphic_testing",
            "exploratory_testing",
            "error_guessing",
            "checklist_based_testing",
            "crowd_testing"
          ]
        },
        "standard": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "criterion": {
          "type": "string",
          "minLength": 1
        },
        "legacy_alias": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "key",
        "standard",
        "reference"
      ],
      "additionalProperties": false
    },
    "ExprNode": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "var": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "var"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "const": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "const"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "and",
                "or",
                "not",
                "eq",
                "neq",
                "lt",
                "lte",
                "gt",
                "gte",
                "add",
                "sub",
                "mul",
                "div"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "shared_defs.schema.json#/$defs/ExprNode"
              },
              "minItems": 1,
              "maxItems": 16
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Generation": {
      "type": "object",
      "properties": {
        "generation_run_id": {
          "type": "string",
          "minLength": 1
        },
        "prompt_template_id": {
          "type": "string",
          "minLength": 1
        },
        "prompt_template_version": {
          "type": "string",
          "minLength": 1
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "output_schema_id": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "provider",
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "parameters": {
          "type": "object",
          "properties": {
            "temperature": {
              "type": [
                "number",
                "null"
              ]
            },
            "seed": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "temperature",
            "seed"
          ],
          "additionalProperties": false
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "review_status": {
          "enum": [
            "pending",
            "self_reviewed",
            "reviewed",
            "rejected"
          ]
        }
      },
      "required": [
        "generation_run_id",
        "prompt_template_id",
        "prompt_template_version",
        "input_sha256",
        "output_schema_id",
        "model",
        "parameters",
        "generated_at",
        "review_status"
      ],
      "additionalProperties": false
    },
    "Parameter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "integer",
            "decimal",
            "number",
            "string",
            "boolean",
            "enum",
            "date",
            "datetime"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "precision": {
          "type": "integer",
          "minimum": 0
        },
        "step": {
          "oneOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "minItems": 1
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "shared_defs.schema.json#/$defs/SourceRef"
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "name",
        "type"
      ],
      "additionalProperties": false
    },
    "DomainModel": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "shared_defs.schema.json#/$defs/SourceRef"
          },
          "minItems": 1
        },
        "observation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "risk_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "variable_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "partition_predicate": {
          "$ref": "shared_defs.schema.json#/$defs/ExprNode"
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "shared_defs.schema.json#/$defs/ExprNode"
          },
          "minItems": 0
        },
        "coverage_criterion": {
          "enum": [
            "simplified_domain",
            "reliable_domain"
          ]
        },
        "borders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "operator": {
                "enum": [
                  "<",
                  "<=",
                  "=",
                  "!=",
                  ">=",
                  ">"
                ]
              },
              "closed": {
                "type": "boolean"
              },
              "predicate": {
                "$ref": "shared_defs.schema.json#/$defs/ExprNode"
              },
              "axis": {
                "type": "string",
                "minLength": 1
              },
              "anchor": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              }
            },
            "required": [
              "id",
              "operator",
              "predicate",
              "axis",
              "anchor"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "source_refs",
        "variable_ids",
        "partition_predicate",
        "borders",
        "coverage_criterion"
      ],
      "additionalProperties": false
    },
    "CombinationModel": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "shared_defs.schema.json#/$defs/SourceRef"
          },
          "minItems": 1
        },
        "observation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "risk_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "parameter_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "shared_defs.schema.json#/$defs/ExprNode"
          },
          "minItems": 0
        },
        "coverage_criterion": {
          "enum": [
            "base_choice",
            "pairwise",
            "n_wise",
            "all"
          ]
        },
        "strength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "base_choice": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      },
      "required": [
        "id",
        "source_refs",
        "parameter_ids",
        "coverage_criterion"
      ],
      "additionalProperties": false
    },
    "Transition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "event": {
          "type": "string",
          "minLength": 1
        },
        "guard": {
          "$ref": "shared_defs.schema.json#/$defs/ExprNode"
        },
        "actions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "shared_defs.schema.json#/$defs/ExprNode"
          }
        },
        "valid": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "event",
        "valid"
      ],
      "additionalProperties": false
    },
    "StateModel": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "shared_defs.schema.json#/$defs/SourceRef"
          },
          "minItems": 1
        },
        "observation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "risk_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "shared_defs.schema.json#/$defs/Transition"
          },
          "minItems": 1
        },
        "contexts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          },
          "minItems": 1
        },
        "coverage_criterion": {
          "enum": [
            "all_states",
            "valid_transitions",
            "all_transitions",
            "n_switch",
            "round_trip"
          ]
        },
        "n": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      },
      "required": [
        "id",
        "source_refs",
        "states",
        "transitions",
        "coverage_criterion"
      ],
      "additionalProperties": false
    },
    "DecisionTable": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "shared_defs.schema.json#/$defs/SourceRef"
          },
          "minItems": 1
        },
        "observation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "risk_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "parameter_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "shared_defs.schema.json#/$defs/ExprNode"
          },
          "minItems": 0
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "conditions": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "minItems": 1
                }
              },
              "actions": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              },
              "feasible": {
                "type": "boolean"
              },
              "represented_rule_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              }
            },
            "required": [
              "id",
              "conditions",
              "actions"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "minimized_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "conditions": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "minItems": 1
                }
              },
              "actions": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              },
              "feasible": {
                "type": "boolean"
              },
              "represented_rule_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              }
            },
            "required": [
              "id",
              "conditions",
              "actions"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "coverage_criterion": {
          "enum": [
            "feasible_rules"
          ]
        }
      },
      "required": [
        "id",
        "source_refs",
        "parameter_ids",
        "rules",
        "coverage_criterion"
      ],
      "additionalProperties": false
    },
    "CrudModel": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "shared_defs.schema.json#/$defs/SourceRef"
          },
          "minItems": 1
        },
        "observation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "risk_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "entity": {
          "type": "string",
          "minLength": 1
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "operation": {
                "enum": [
                  "C",
                  "R",
                  "U",
                  "D"
                ]
              },
              "function": {
                "type": "string",
                "minLength": 1
              },
              "read_path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "operation",
              "function"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "read_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "coverage_criterion": {
          "enum": [
            "completeness",
            "consistency"
          ]
        }
      },
      "required": [
        "id",
        "source_refs",
        "entity",
        "operations",
        "coverage_criterion"
      ],
      "additionalProperties": false
    },
    "ScenarioModel": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "shared_defs.schema.json#/$defs/SourceRef"
          },
          "minItems": 1
        },
        "observation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "risk_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "paths": {
          "type": "array",
