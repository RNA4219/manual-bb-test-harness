          "reference": "TA-3.4.1",
          "criterion": "session_based"
        },
        {
          "key": "error_guessing",
          "standard": "ISTQB CTAL-TA v4.0",
          "reference": "TA-3.4.2",
          "criterion": "failure_modes"
        }
      ],
      "basis_refs": [
        "BR-1",
        "ip1"
      ],
      "mission": "在庫サービス失敗時のシステム振る舞いを検証し、データ整合性の破綻がないことを確認する",
      "resources": [
        "ネットワーク遮断ツール",
        "ログ監視ツール",
        "在庫サービスモック"
      ],
      "entry_criteria": [
        "テスト環境で在庫サービスの失敗をシミュレーションできること"
      ],
      "exit_criteria": [
        "失敗シナリオでの復旧動作が確認されたこと",
        "データ整合性の破綻が見つからないこと、または既知の制限として文書化されたこと"
      ],
      "environment": "テスト環境（在庫サービスモック利用可）",
      "limitations": [
        "本番環境でのネットワーク故障はシミュレーションできない",
        "補償トランザクションの詳細実装は仕様で明示されていない"
      ],
