{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RNA4219/manual-bb-test-harness/schemas/phase_contract.schema.json",
  "title": "PhaseContract",
  "description": "Definition of Ready and Phase 1 contract artifact produced from planning notes, mockups, and early requirements before development starts.",
  "type": "object",
  "required": [
    "contract_id",
    "feature_id",
    "readiness",
    "problem_owner",
    "success_conditions",
    "phase1_scope",
    "phase1_non_goals",
    "open_questions",
    "spec_gaps",
    "technical_risks",
    "metrics",
    "test_lenses",
    "source_refs"
  ],
  "properties": {
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "feature_id": {
      "type": "string",
      "minLength": 1
    },
    "readiness": {
      "type": "object",
      "required": ["status", "decision", "reasons", "required_before_dev"],
      "properties": {
        "status": {
          "enum": ["ok", "degraded", "blocked"]
        },
        "decision": {
          "enum": ["ready", "ready_with_conditions", "not_ready"]
        },
        "reasons": {
          "type": "array",
          "items": {"type": "string"}
        },
        "required_before_dev": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "problem_owner": {
      "type": "object",
      "required": ["persona", "problem"],
      "properties": {
        "persona": {
          "type": "string",
          "minLength": 1
        },
        "problem": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "success_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text", "source_refs"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "metric": {"type": "string"},
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    },
    "phase1_scope": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "phase1_non_goals": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "question", "owner", "blocks_ready"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "question": {"type": "string", "minLength": 1},
          "owner": {"type": "string"},
          "due": {"type": "string"},
          "blocks_ready": {"type": "boolean"},
          "source_refs": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    },
    "spec_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "gap", "impact", "needed_oracle"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "gap": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1},
          "needed_oracle": {"type": "string"},
          "source_refs": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    },
    "technical_risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "risk", "mitigation"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "risk": {"type": "string", "minLength": 1},
          "mitigation": {"type": "string"},
          "owner": {"type": "string"},
          "source_refs": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "test_lenses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "lens", "title", "rationale", "trace_to"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "lens": {
            "enum": ["flow", "state", "rule", "data", "role", "regression", "usability", "recovery"]
          },
          "title": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1},
          "trace_to": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "shared_defs.schema.json#/$defs/SourceRef"}
    },
    "assumptions": {
      "type": "array",
      "items": {"$ref": "shared_defs.schema.json#/$defs/Assumption"}
    },
    "confidence": {
      "$ref": "shared_defs.schema.json#/$defs/ConfidenceLevel"
    }
  },
  "additionalProperties": false
}
