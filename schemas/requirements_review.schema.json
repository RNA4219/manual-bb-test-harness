{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RNA4219/manual-bb-test-harness/schemas/requirements_review.schema.json",
  "title": "requirements_review",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "feature_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewed_at": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "format": "date-time"}
      ]
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirement_id": {
            "type": "string",
            "pattern": "\\S"
          },
          "reviewed": {
            "type": "boolean"
          },
          "oracle": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "requirement_id",
          "reviewed",
          "oracle",
          "source_refs"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S"
          },
          "kind": {
            "enum": [
              "question",
              "ambiguity",
              "contradiction",
              "missing_oracle",
              "missing_source"
            ]
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "text": {
            "type": "string",
            "pattern": "\\S"
          },
          "requirement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "due": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "severity",
          "text",
          "requirement_ids",
          "source_refs"
        ],
        "additionalProperties": false
      }
    },
    "resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue_id": {
            "type": "string",
            "pattern": "\\S"
          },
          "decision": {
            "type": "string",
            "pattern": "\\S"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "issue_id",
          "decision",
          "source_refs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "feature_id",
    "input_sha256",
    "reviewer",
    "reviewed_at",
    "requirements",
    "findings",
    "resolutions"
  ],
  "additionalProperties": false
}
