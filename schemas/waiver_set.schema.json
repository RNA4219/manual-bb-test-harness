{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RNA4219/manual-bb-test-harness/schemas/waiver_set.schema.json",
  "title": "WaiverSet",
  "type": "object",
  "required": ["feature_id", "build_id", "waivers"],
  "properties": {
    "feature_id": {"type": "string", "minLength": 1},
    "build_id": {"type": "string", "minLength": 1},
    "waivers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "risk_ids", "reason", "owner", "expires_at", "containment", "rollback"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "risk_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "reason": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "expires_at": {"type": "string", "format": "date-time"},
          "containment": {"type": "string", "minLength": 1},
          "rollback": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
