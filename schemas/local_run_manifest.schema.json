{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RNA4219/manual-bb-test-harness/schemas/local_run_manifest.schema.json",
  "title": "LocalRunManifest",
  "type": "object",
  "required": [
    "run_id",
    "status",
    "profile",
    "base_url",
    "model",
    "config_hash",
    "input_sha256",
    "started_at",
    "finished_at",
    "elapsed_seconds",
    "stages",
    "artifacts"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "succeeded",
        "failed"
      ]
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "base_url": {
      "type": "string",
      "format": "uri"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "config_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "elapsed_seconds": {
      "type": "number",
      "minimum": 0
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "elapsed_seconds",
          "repairs",
          "schema_valid",
          "usage"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "elapsed_seconds": {
            "type": "number",
            "minimum": 0
          },
          "repairs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "schema_valid": {
            "type": "boolean"
          },
          "usage": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "schema_valid"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "schema_valid": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "error": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.1.0"
    },
    "migration": {
      "$ref": "shared_defs.schema.json#/$defs/Migration"
    },
    "generation": {
      "$ref": "shared_defs.schema.json#/$defs/Generation"
    },
    "generation_mode": {
      "enum": [
        "compact",
        "full",
        "batched"
      ]
    },
    "stop_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "usage_summary": {
      "type": "object",
      "properties": {
        "calls": {
          "type": "integer",
          "minimum": 0
        },
        "repair_calls": {
          "type": "integer",
          "minimum": 0
        },
        "unreported_calls": {
          "type": "integer",
          "minimum": 0
        },
        "reported_total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "accounted_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "prompt_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "completion_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "budget_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "remaining_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "budget_exhausted": {
          "type": "boolean"
        },
        "estimation_method": {
          "const": "utf8_bytes_plus_256_v1"
        }
      },
      "required": [
        "calls",
        "repair_calls",
        "unreported_calls",
        "reported_total_tokens",
        "accounted_tokens",
        "prompt_tokens",
        "completion_tokens",
        "total_tokens",
        "budget_tokens",
        "remaining_tokens",
        "budget_exhausted",
        "estimation_method"
      ],
      "additionalProperties": false
    },
    "call_records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string"
          },
          "repair": {
            "type": "boolean"
          },
          "estimated_input_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "max_output_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "outcome": {
            "enum": [
              "pending",
              "returned",
              "succeeded",
              "invalid_artifact",
              "runtime_error",
              "budget_blocked",
              "json_parse_error",
              "output_truncated",
              "incomplete_response"
            ]
          },
          "elapsed_seconds": {
            "type": "number",
            "minimum": 0
          },
          "prompt_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "completion_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "total_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "usage_status": {
            "enum": [
              "reported",
              "unknown",
              "invalid"
            ]
          },
          "accounted_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "finish_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "stage",
          "repair",
          "estimated_input_tokens",
          "max_output_tokens",
          "outcome",
          "elapsed_seconds",
          "prompt_tokens",
          "completion_tokens",
          "total_tokens",
          "usage_status",
          "accounted_tokens"
        ],
        "additionalProperties": false
      }
    },
    "design_status": {
      "enum": [
        "ready",
        "degraded",
        "blocked"
      ]
    },
    "comparison_config_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
